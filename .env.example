# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TDSNTLMS Initial Super Admin Default Password (Server PBKDF2 Hashed on startup)
INITIAL_ADMIN_PASSWORD="STAFF0606"

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key for server-side video metadata & duration retrieval.
# If omitted, the server automatically falls back to oEmbed and client player runtime duration discovery.
YOUTUBE_API_KEY="AIzaSyDlKLfkSqStMTer23kX0YpDDXL0IYe8nY4"

# KAKAO_CLIENT_ID / VITE_KAKAO_CLIENT_ID: Kakao Developers REST API Key (Client ID)
# Used for Kakao Social Login. Register Redirect URI in Kakao Developers: <APP_URL>/api/auth/kakao/callback
KAKAO_CLIENT_ID="65026cc797ba38ea123d4cdb28a82857"
VITE_KAKAO_CLIENT_ID="65026cc797ba38ea123d4cdb28a82857"

# KAKAO_CLIENT_SECRET: Optional Kakao Client Secret code (Kakao Developers -> 보안)
KAKAO_CLIENT_SECRET="VbgQFeOhP3PKfi7jOhmlprdFkugPd5DA"

# KAKAO_REDIRECT_URI / VITE_KAKAO_REDIRECT_URI: Kakao OAuth Redirect URI (Optional, auto-resolved from APP_URL)
KAKAO_REDIRECT_URI=""
VITE_KAKAO_REDIRECT_URI=""

# NAVER_CLIENT_ID / VITE_NAVER_CLIENT_ID: Naver Developers Client ID
# Used for Naver Social Login. Register Callback URL: <APP_URL>/api/auth/naver/callback
NAVER_CLIENT_ID=""
VITE_NAVER_CLIENT_ID=""

# NAVER_CLIENT_SECRET: Naver Developers Client Secret
NAVER_CLIENT_SECRET=""

# NAVER_REDIRECT_URI / VITE_NAVER_REDIRECT_URI: Naver OAuth Redirect URI (Optional, auto-resolved from APP_URL)
NAVER_REDIRECT_URI=""
VITE_NAVER_REDIRECT_URI=""

# GOOGLE_CLIENT_ID / VITE_GOOGLE_CLIENT_ID: Optional Google OAuth Client ID (or via Firebase Auth)
GOOGLE_CLIENT_ID=""
VITE_GOOGLE_CLIENT_ID=""


# FIREBASE_SERVICE_ACCOUNT: Firebase Admin service account key (raw JSON or base64) for storing
# uploaded videos/avatars in Firebase Storage. If empty, uploads stay on local disk (uploads/).
# Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=""
